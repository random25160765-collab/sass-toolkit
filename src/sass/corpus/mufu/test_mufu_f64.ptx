.version 8.4
.target sm_89
.address_size 64

.visible .entry test_mufu_f64(.param .u64 input, .param .u64 output)
.maxntid 32, 1, 1
{
    .reg .f64 da, db;
    .reg .b64 d1, d2;

    ld.param.u64 d1, [input];
    ld.param.u64 d2, [output];
    ld.f64 da, [d1];

    // VAR 1: RCP64H
    rcp.approx.ftz.f64 db, da;
    st.f64 [d2], db;

    // VAR 2: RSQ64H
    rsqrt.approx.f64 db, da;
    st.f64 [d2+8], db;

    ret;
}
