// test_sel.ptx - probe SEL encoding variants on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_sel(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .s32 ra, rb, rc, rd;
    .reg .f32 fa, fb, fd;
    .reg .pred %p0, %p1;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.s32       ra, [rd1+0];
    ld.s32       rb, [rd1+4];
    ld.f32       fa, [rd1+0];
    ld.f32       fb, [rd1+4];
    mov.s32      rc, 0;

    // Case 1: SEL R,R,R,P  (s32 reg vs reg)
    selp.b32     rd, ra, rb, %p0;
    st.s32       [rd2+0], rd;

    // Case 2: SEL with !P (cNOT=1)
    selp.b32     rd, ra, rb, !%p0;
    st.s32       [rd2+4], rd;

    // Case 3: SEL R,R,I,P  (reg vs 0)
    selp.b32     rd, ra, rc, %p0;
    st.s32       [rd2+8], rd;

    // Case 4: SEL f32 (float select)
    selp.f32     fd, fa, fb, %p0;
    st.f32       [rd2+12], fd;

    ret;
}
