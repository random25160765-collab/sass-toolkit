.version 8.6
.target sm_89
.address_size 64

.visible .entry test_hsetp2(.param .u64 input, .param .u64 output)
.maxntid 32, 1, 1
{
    .reg .b32 ra, rb;
    .reg .b16 ha, hb;
    .reg .pred %p0;
    .reg .b64 d1, d2;

    ld.param.u64 d1, [input];
    ld.param.u64 d2, [output];
    ld.b32 ra, [d1];

    cvt.rn.f16.f32 ha, ra;
    shr.b32 rb, ra, 16;
    cvt.rn.f16.f32 hb, rb;

    setp.lt.f16 %p0, ha, hb;
    @%p0 st.b32 [d2], ra;

    setp.eq.f16 %p0, ha, hb;
    @%p0 st.b32 [d2+4], ra;

    setp.lt.f16x2 %p0, ra, rb;
    @%p0 st.b32 [d2+8], ra;

    ret;
}
