.version 8.4
.target sm_89
.address_size 64

.visible .entry test_lds_types(
    .param .u64 output
)
.maxntid 32, 1, 1
{
    .reg .f32 rf;
    .reg .b32 ri, rj, rk;
    .reg .b64 rd2;
    .shared .align 4 .b32 sdata[16];

    ld.param.u64 rd2, [output];

    // f32 load
    ld.shared.f32 rf, [sdata+0];
    st.global.f32 [rd2+0], rf;

    // u32 load
    ld.shared.u32 ri, [sdata+4];
    st.global.u32 [rd2+4], ri;

    // s32 load
    ld.shared.s32 rj, [sdata+8];
    st.global.u32 [rd2+8], rj;

    // u8 load
    ld.shared.u8 rk, [sdata+12];
    st.global.u32 [rd2+12], rk;

    ret;
}
