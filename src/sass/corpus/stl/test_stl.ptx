.version 8.4
.target sm_89
.address_size 64

.visible .entry test_stl(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .f32 rf;
    .reg .b32 ri;
    .reg .b64 rd1, rd2;
    .local .align 4 .b32 ldata[8];

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.global.f32 rf, [rd1];
    ld.global.u32 ri, [rd1+4];

    st.local.f32 [ldata+0], rf;
    st.local.u32 [ldata+4], ri;

    ret;
}
