// test_hfma2.ptx - verify HFMA2 encoding on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_hfma2(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .b32 ra, rb, rc, rd;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.u32 ra, [rd1+0];
    ld.u32 rb, [rd1+4];
    ld.u32 rc, [rd1+8];

    // fma.f16x2
    fma.rn.f16x2 rd, ra, rb, rc;
    st.u32 [rd2+0], rd;

    ret;
}
