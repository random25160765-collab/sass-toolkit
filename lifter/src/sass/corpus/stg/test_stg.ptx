// test_stg.ptx - probe STG encoding on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_stg(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .f32 rf;
    .reg .b32 ri;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.global.f32 rf, [rd1];
    ld.global.u32 ri, [rd1+4];

    // Case 1: st.global.f32
    st.global.f32 [rd2+0], rf;

    // Case 2: st.global.u32
    st.global.u32 [rd2+4], ri;

    ret;
}
