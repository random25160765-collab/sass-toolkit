// test_hset2.ptx - verify HSET2 on SM89
.version 8.4
.target sm_89
.address_size 64
.visible .entry test_hset2(.param .u64 i, .param .u64 o) {
    .reg .b32 ra, rb, rd; .reg .pred p0; .reg .b64 rd1, rd2;
    ld.param.u64 rd1, [i]; ld.param.u64 rd2, [o];
    ld.u32 ra, [rd1+0]; ld.u32 rb, [rd1+4];
    setp.lt.f16x2 p0, ra, rb;
    @p0 mov.b32 rd, 1; @!p0 mov.b32 rd, 0;
    st.b32 [rd2+0], rd; ret;
}
