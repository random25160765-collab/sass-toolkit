// test_cnot2.ptx - force ISETP.EX + AND chain to expose cNOT on predicates
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_cnot2(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .s32 ra, rb, rc, rd;
    .reg .pred %p0, %p1, %p2, %p3;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.s32       ra, [rd1+0];
    ld.s32       rb, [rd1+4];
    ld.s32       rc, [rd1+8];

    // dual output: p0 = (ra > rb), p1 = !(ra > rb)  [ISETP.EX without chain]
    setp.gt.s32  %p0|%p1, ra, rb;

    // AND chain with EX: p2 = p0 & (rc > 0), p3 = !p2
    setp.gt.and.s32 %p2|%p3, rc, 0, %p0;

    @%p2 mov.s32 rd, 1;
    @%p3 mov.s32 rd, -1;
    st.s32       [rd2+0], rd;
    ret;
}
