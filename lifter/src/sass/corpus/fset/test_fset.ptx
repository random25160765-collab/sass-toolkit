// test_fset.ptx - verify FSET encoding on SM89
.version 8.4
.target sm_89
.address_size 64
.visible .entry test_fset(.param .u64 i, .param .u64 o) {
    .reg .f32 fa, fb; .reg .b32 rd; .reg .pred p0; .reg .b64 rd1, rd2;
    ld.param.u64 rd1, [i]; ld.param.u64 rd2, [o];
    ld.f32 fa, [rd1+0]; ld.f32 fb, [rd1+4];
    setp.lt.f32 p0, fa, fb; selp.b32 rd, 1, 0, p0;
    st.b32 [rd2+0], rd; ret;
}
