// test_iabs.ptx - verify IABS encoding on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_iabs(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .s32 ra, rb, rc;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.s32 ra, [rd1+0];

    // abs.s32 (expect IABS)
    abs.s32 rc, ra;
    st.s32 [rd2+0], rc;

    ret;
}
