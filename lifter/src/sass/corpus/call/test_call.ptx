.version 8.4
.target sm_89
.address_size 64

// Subroutine definitions (must come before use)
.func callee_empty()
{
    ret;
}

.func callee_with_param(.reg .b32 x)
{
    add.u32 x, x, 1;
    ret;
}

.visible .entry test_call(.param .u64 output)
.maxntid 32, 1, 1
{
    .reg .b32 ri;
    .reg .b64 d2;

    ld.param.u64 d2, [output];
    mov.u32 ri, 0;

    // VAR 1: Direct call, no params
    call callee_empty, ();

    // VAR 2: Direct call with param
    call callee_with_param, (ri);

    // VAR 3: Direct call.uni
    call.uni callee_empty, ();

    // VAR 4: call.uni with param
    call.uni callee_with_param, (ri);

    st.global.u32 [d2+0], ri;
    ret;
}
