.version 8.4
.target sm_89
.address_size 64

.visible .entry test_shfl(.param .u64 output)
.maxntid 32, 1, 1
{
    .reg .pred %p0;
    .reg .b32 ra, rd;
    .reg .b64 d2;

    ld.param.u64 d2, [output];
    mov.u32 rd, 0;

    // SHFL.IDX: shfl from lane index
    shfl.sync.idx.b32 rd, rd, 0, 0x1f, 0x0;
    st.global.u32 [d2+0], rd;

    // SHFL.UP: shift up by delta
    shfl.sync.up.b32 rd, rd, 0x2, 0x0, 0x1f;
    st.global.u32 [d2+4], rd;

    // SHFL.DOWN: shift down by delta
    shfl.sync.down.b32 rd, rd, 0x2, 0x0, 0x1f;
    st.global.u32 [d2+8], rd;

    // SHFL.BFLY: butterfly XOR swap
    shfl.sync.bfly.b32 rd, rd, 0x1, 0x0, 0x1f;
    st.global.u32 [d2+12], rd;

    ret;
}
