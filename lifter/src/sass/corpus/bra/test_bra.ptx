.version 8.4
.target sm_89
.address_size 64

.visible .entry test_bra(.param .u64 output)
.maxntid 32, 1, 1
{
    .reg .pred %p0;
    .reg .b32 ri;
    .reg .b64 d2;

    ld.param.u64 d2, [output];
    mov.u32 ri, 0;

    setp.ne.u32 %p0, ri, 1;

    // Conditional branch
    @%p0 bra L1;
    st.global.u32 [d2+0], ri;

L1:
    st.global.u32 [d2+4], ri;

    ret;
}
