// test_mov2.ptx - probe MOV vs IMAD.MOV boundary on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_mov2(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .b32 ra, rb, rc;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.u32 ra, [rd1+0];
    ld.u32 rb, [rd1+4];

    // pure reg copy
    mov.b32 rc, ra;
    st.u32 [rd2+0], rc;

    // another reg copy
    mov.b32 rc, rb;
    st.u32 [rd2+4], rc;

    ret;
}
