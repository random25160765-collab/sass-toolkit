// test_mov3.ptx - probe MOV_R_R_I (3-operand MOV) on SM89
.version 8.4
.target sm_89
.address_size 64

.visible .entry test_mov3(
    .param .u64 input,
    .param .u64 output
)
{
    .reg .b32 ra, rb, rc, rd, re;
    .reg .b64 rd1, rd2;

    ld.param.u64 rd1, [input];
    ld.param.u64 rd2, [output];
    ld.u32 ra, [rd1+0];
    ld.u32 rb, [rd1+4];

    // Case 1: mov + add immediate (Rd = Ra + 8) - may compile to MOV_R_R_I
    mov.b32 rc, ra;
    add.u32 rd, rc, 8;
    st.u32 [rd2+0], rd;

    // Case 2: mov + add register (Rd = Ra + Rb) - for comparison
    mov.b32 rc, ra;
    add.u32 re, rc, rb;
    st.u32 [rd2+4], re;

    ret;
}
